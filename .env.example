# Run python -m app.cli init to generate the three local keys without printing them.
BOT_MODE=demo
BOT_ADMIN_KEY=
DATA_KEY=
IDENTITY_HASH_KEY=
DATA_DIR=./data

# NEW channel only. Never reuse the shop's token, secret or webhook.
LINE_NEW_CHANNEL_SECRET=
LINE_NEW_CHANNEL_ACCESS_TOKEN=
LINE_NEW_BOT_USER_ID=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_VISION_MODEL=
OPENROUTER_ZDR=true
# Enable only for a model whose endpoint supports disabling reasoning.
OPENROUTER_DISABLE_REASONING=false
# Set false for endpoints that do not support temperature (e.g. GPT-6 Luna).
OPENROUTER_SEND_TEMPERATURE=true
# Use json_object only for planner endpoints without native JSON Schema.
# Local schema/evidence validation remains mandatory. Vision uses json_schema.
OPENROUTER_PLANNER_FORMAT=json_schema
# 1-20 seconds; text requests also have an overall 40-second deadline.
PLANNER_TIMEOUT_SECONDS=8
# Local LightRAG keyword extraction can exceed 8s for a new question.
# Retrieval/planner are capped by the shared 40s request deadline.
RETRIEVAL_TIMEOUT_SECONDS=20
# OpenRouter planner/Vision only: at most one extra HTTP 429/503 attempt.
# Wait + attempts share the original stage timeout; every attempt counts.
PROVIDER_MAX_RETRIES=1
PROVIDER_RETRY_MAX_WAIT_SECONDS=2
ALLOW_PAID_MODELS=false
MODEL_CALLS_PER_DAY=40
# Independent LightRAG query limits; these do not raise cloud model budgets.
RETRIEVAL_CALLS_PER_DAY=1000
RETRIEVAL_CALLS_PER_MINUTE=30
# Separate limits per guard role (text/image); no effect on cloud LLM budgets.
GUARD_CALLS_PER_DAY=1000
GUARD_CALLS_PER_MINUTE=30

LIGHTRAG_URL=http://127.0.0.1:9621
LIGHTRAG_API_KEY=
LIGHTRAG_MODE=mix

# OpenAI-compatible inference server actually serving Llama Guard.
# This is not the ordinary chat model. Guard must return exactly safe or unsafe.
GUARD_BASE_URL=http://127.0.0.1:1234/v1
GUARD_API_KEY=
GUARD_MODEL=
# Image guard uses OpenAI directly; this key is separate from OpenRouter.
IMAGE_GUARD_PROVIDER=openai
IMAGE_GUARD_MODEL=omni-moderation-latest
OPENAI_MODERATION_API_KEY=
ENABLE_IMAGES=false
SESSION_TTL_SECONDS=1800
IMAGE_CONTEXT_TTL_SECONDS=300
MAX_IMAGE_BYTES=5000000
# Content-free JSONL traces, 1 MB per file and 3 rotated backups.
DIAGNOSTICS_ENABLED=true
# Cosmetic DM animation only, best effort; no push/reply-token use.
LINE_LOADING_ENABLED=true
LINE_LOADING_SECONDS=40
