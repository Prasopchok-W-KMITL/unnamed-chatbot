# Copy to .env.lightrag. Do not copy the bot's full .env into this service.
HOST=0.0.0.0
PORT=9621
WORKING_DIR=/app/data/rag_storage
INPUT_DIR=/app/data/inputs
LIGHTRAG_API_KEY=
WHITELIST_PATHS=/health
ENABLE_API_DOCS=false
LOG_LEVEL=WARNING
VERBOSE=false
SUMMARY_LANGUAGE=Thai

# Local Ollama on the Windows host; Docker reaches it through host.docker.internal.
# Download first: ollama pull gemma3:4b; ollama pull bge-m3
LLM_BINDING=ollama
LLM_BINDING_HOST=http://host.docker.internal:11434
LLM_BINDING_API_KEY=
LLM_MODEL=gemma3:4b
OLLAMA_LLM_NUM_CTX=8192
OLLAMA_LLM_NUM_PREDICT=2048
OLLAMA_LLM_TEMPERATURE=0
LLM_TIMEOUT=240
MAX_ASYNC_LLM=1
KEYWORD_MAX_ASYNC_LLM=1
QUERY_MAX_ASYNC_LLM=1
MAX_PARALLEL_INSERT=2
MAX_TOTAL_TOKENS=5500
MAX_ENTITY_TOKENS=1500
MAX_RELATION_TOKENS=1500
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=0
WORKSPACE=unnamed_new

# Embedding is a separate multilingual model. Do not change an existing index's
# model/dimension; use a new workspace and re-ingest if it already has vectors.
EMBEDDING_BINDING=ollama
EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
EMBEDDING_BINDING_API_KEY=
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIM=false
OLLAMA_EMBEDDING_NUM_CTX=8192
EMBEDDING_FUNC_MAX_ASYNC=1

# Optional cloud LLM instead: LLM_BINDING=openai, set its host/key/model,
# then enable this routing policy only after verifying a compatible endpoint.
# OPENAI_LLM_EXTRA_BODY='{"provider":{"data_collection":"deny","zdr":true,"max_price":{"prompt":0,"completion":0}}}'
